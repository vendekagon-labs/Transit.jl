#!/usr/bin/env -S julia --project --startup-file=no

# Reads each transit value from stdin as it arrives and writes it back to
# stdout.
#
# usage: read-write [json|json-verbose]

import Transit

const encoding = isempty(ARGS) ? "json" : ARGS[1]
encoding in ("json", "json-verbose") ||
    error("Unsupported encoding: $encoding (expected json or json-verbose)")
const verbose = encoding == "json-verbose"

for value in Transit.eachvalue(stdin)
    Transit.write(stdout, value, verbose)
    flush(stdout)
end
