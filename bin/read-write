#!/usr/bin/env -S julia --project --startup-file=no

# Reads each transit value from stdin as it arrives and writes it back to
# stdout.
#
# usage: read-write [json|json-verbose|msgpack]

import Transit

const format = Symbol(replace(isempty(ARGS) ? "json" : ARGS[1], "-" => "_"))

for value in Transit.eachvalue(stdin; format=format)
    Transit.write(stdout, value, format)
    flush(stdout)
end
